{
  "slug": "menu-dropdown",
  "title": "Menu Dropdown",
  "description": "An accessible click (or hover) dropdown of links you can drop into any Code Block.",
  "tags": ["navigation", "menus", "dropdown"],
  "requires": "css+js",
  "install": "code-block",
  "options": [
    {
      "name": "data-sp-dropdown",
      "type": "attribute",
      "on": ".sp-dropdown",
      "values": ["", "hover"],
      "default": "",
      "required": true,
      "description": "Turns the dropdown on. Set to \"hover\" to also open on mouse hover."
    },
    {
      "name": "data-sp-align",
      "type": "attribute",
      "on": ".sp-dropdown",
      "values": ["left", "right"],
      "default": "left",
      "description": "Which edge of the button the menu lines up with."
    },
    { "name": "--sp-dropdown-font", "type": "css-variable", "on": ":root or one .sp-dropdown", "default": "inherit", "description": "Font family" },
    { "name": "--sp-dropdown-font-size", "type": "css-variable", "on": ":root or one .sp-dropdown", "default": "1rem", "description": "Base font size" },
    { "name": "--sp-dropdown-toggle-bg", "type": "css-variable", "on": ":root or one .sp-dropdown", "default": "transparent", "description": "Button background" },
    { "name": "--sp-dropdown-toggle-color", "type": "css-variable", "on": ":root or one .sp-dropdown", "default": "currentColor", "description": "Button text color" },
    { "name": "--sp-dropdown-toggle-padding", "type": "css-variable", "on": ":root or one .sp-dropdown", "default": "0.6em 1em", "description": "Button padding" },
    { "name": "--sp-dropdown-toggle-radius", "type": "css-variable", "on": ":root or one .sp-dropdown", "default": "6px", "description": "Button corner radius" },
    { "name": "--sp-dropdown-toggle-border", "type": "css-variable", "on": ":root or one .sp-dropdown", "default": "1px solid currentColor", "description": "Button border" },
    { "name": "--sp-dropdown-bg", "type": "css-variable", "on": ":root or one .sp-dropdown", "default": "#fff", "description": "Menu background" },
    { "name": "--sp-dropdown-color", "type": "css-variable", "on": ":root or one .sp-dropdown", "default": "#161616", "description": "Menu text color" },
    { "name": "--sp-dropdown-hover-bg", "type": "css-variable", "on": ":root or one .sp-dropdown", "default": "#f2f2f2", "description": "Link hover and focus background" },
    { "name": "--sp-dropdown-accent", "type": "css-variable", "on": ":root or one .sp-dropdown", "default": "#161616", "description": "Focus outline color" },
    { "name": "--sp-dropdown-radius", "type": "css-variable", "on": ":root or one .sp-dropdown", "default": "8px", "description": "Menu corner radius" },
    { "name": "--sp-dropdown-shadow", "type": "css-variable", "on": ":root or one .sp-dropdown", "default": "0 10px 30px rgba(0, 0, 0, 0.12)", "description": "Menu shadow" },
    { "name": "--sp-dropdown-width", "type": "css-variable", "on": ":root or one .sp-dropdown", "default": "14rem", "description": "Minimum menu width" },
    { "name": "--sp-dropdown-offset", "type": "css-variable", "on": ":root or one .sp-dropdown", "default": "0.4rem", "description": "Gap between button and menu" },
    { "name": "--sp-dropdown-item-padding", "type": "css-variable", "on": ":root or one .sp-dropdown", "default": "0.6em 1em", "description": "Link padding" },
    { "name": "--sp-dropdown-z", "type": "css-variable", "on": ":root or one .sp-dropdown", "default": "1000", "description": "Menu stacking order" },
    { "name": "--sp-dropdown-speed", "type": "css-variable", "on": ":root or one .sp-dropdown", "default": "0.18s", "description": "Open and close animation time" }
  ]
}
