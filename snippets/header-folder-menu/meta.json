{
  "slug": "header-folder-menu",
  "title": "Header Folder Menu",
  "description": "Restyle chosen header folder dropdowns with a fade, a hover close delay, and arrow-key navigation.",
  "tags": ["navigation", "header", "menus", "dropdown"],
  "requires": "css+js",
  "install": "code-injection",
  "options": [
    {
      "name": "data-sp-folders",
      "type": "attribute",
      "on": "<script> tag",
      "default": null,
      "required": true,
      "example": "Services, Shop",
      "description": "Which header folders to upgrade: folder titles or URL slugs, comma separated, or \"*\" for all."
    },
    { "name": "--sp-folder-bg", "type": "css-variable", "on": ":root", "default": null, "description": "Menu background. Unset = your header's background." },
    { "name": "--sp-folder-color", "type": "css-variable", "on": ":root", "default": null, "description": "Link color. Unset = your header's link color." },
    { "name": "--sp-folder-hover-bg", "type": "css-variable", "on": ":root", "default": "rgba(127, 127, 127, 0.12)", "description": "Link hover and focus background" },
    { "name": "--sp-folder-accent", "type": "css-variable", "on": ":root", "default": "currentColor", "description": "Focus outline color" },
    { "name": "--sp-folder-radius", "type": "css-variable", "on": ":root", "default": "8px", "description": "Menu corner radius" },
    { "name": "--sp-folder-shadow", "type": "css-variable", "on": ":root", "default": "0 10px 30px rgba(0, 0, 0, 0.12)", "description": "Menu shadow" },
    { "name": "--sp-folder-padding", "type": "css-variable", "on": ":root", "default": "0.4rem", "description": "Space inside the menu edge" },
    { "name": "--sp-folder-item-padding", "type": "css-variable", "on": ":root", "default": "0.55em 0.9em", "description": "Link padding" },
    { "name": "--sp-folder-item-radius", "type": "css-variable", "on": ":root", "default": "4px", "description": "Link hover-highlight radius" },
    { "name": "--sp-folder-min-width", "type": "css-variable", "on": ":root", "default": "200px", "description": "Minimum menu width" },
    { "name": "--sp-folder-offset", "type": "css-variable", "on": ":root", "default": "0.5rem", "description": "Gap between the folder title and the menu" },
    { "name": "--sp-folder-z", "type": "css-variable", "on": ":root", "default": "1000", "description": "Menu stacking order" },
    { "name": "--sp-folder-speed", "type": "css-variable", "on": ":root", "default": "0.18s", "description": "Fade and slide time" },
    { "name": "--sp-folder-close-delay", "type": "css-variable", "on": ":root", "default": "250ms", "description": "Wait before closing after the mouse leaves" }
  ]
}
